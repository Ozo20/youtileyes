  completedAt    DateTime?
  failureMessage String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  planScenario PlanScenario @relation(fields: [planScenarioId], references: [id], onDelete: Cascade)

  runs           SolverRun[]
  recoveryCase   RecoveryCase? @relation(fields: [recoveryCaseId], references: [id], onDelete: SetNull)
  recoveryCaseId String?

  @@index([tenantId, status])
  @@index([tenantId, planScenarioId])
  @@index([tenantId, queuedAt])
  @@index([tenantId, recoveryCaseId])
}

model SolverRun {
  id                String          @id @default(uuid())
  tenantId          String
  solverJobId       String
  status            SolverRunStatus @default(STARTED)
  solverName        String
  solverVersion     String?
  objectiveValue    Float?
  bestBound         Float?
  wallTimeSeconds   Float?
  branches          BigInt?
  conflicts         BigInt?
  deterministicTime Float?
  startedAt         DateTime        @default(now())
  completedAt       DateTime?
  diagnostics       Json?
  createdAt         DateTime        @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  solverJob SolverJob @relation(fields: [solverJobId], references: [id], onDelete: Cascade)

  violations ConstraintViolation[]

  @@index([tenantId, solverJobId])
  @@index([tenantId, status])
}

model SolverObjective {
  id             String   @id @default(uuid())
  tenantId       String
  planScenarioId String
  key            String
  name           String
  weight         Int      @default(100)
  targetValue    Float?
  actualValue    Float?
  penaltyValue   Float?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  planScenario PlanScenario @relation(fields: [planScenarioId], references: [id], onDelete: Cascade)

  @@unique([tenantId, planScenarioId, key])
  @@index([tenantId, planScenarioId])
}

model ConstraintViolation {
  id             String                      @id @default(uuid())
  tenantId       String
  solverRunId    String
  planningRuleId String?
  severity       ConstraintViolationSeverity
  code           String
  description    String?
  entityType     String?
  entityId       String?
  penaltyValue   Float?
  metadata       Json?
  createdAt      DateTime                    @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  solverRun    SolverRun     @relation(fields: [solverRunId], references: [id], onDelete: Cascade)
  planningRule PlanningRule? @relation(fields: [planningRuleId], references: [id], onDelete: SetNull)

  @@index([tenantId, solverRunId])
  @@index([tenantId, planningRuleId])
  @@index([tenantId, severity])
  @@index([tenantId, entityType, entityId])
}

model ScenarioMetric {
  id             String             @id @default(uuid())
  tenantId       String
  planScenarioId String
  metricType     ScenarioMetricType
  key            String?
  value          Float
  unit           String?
  metadata       Json?
  createdAt      DateTime           @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  planScenario PlanScenario @relation(fields: [planScenarioId], references: [id], onDelete: Cascade)

  @@index([tenantId, planScenarioId])
  @@index([tenantId, metricType])
}

model ScenarioChange {
  id                String             @id @default(uuid())
  tenantId          String
  planScenarioId    String
  scenarioSessionId String?
  sourceSessionId   String?
  changeType        ScenarioChangeType
  explanationCode   String?
  explanation       String?
  beforeState       Json?
  afterState        Json?
  penaltyDelta      Float?
  createdAt         DateTime           @default(now())

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  planScenario    PlanScenario     @relation(fields: [planScenarioId], references: [id], onDelete: Cascade)
  scenarioSession ScenarioSession? @relation(fields: [scenarioSessionId], references: [id], onDelete: SetNull)
  sourceSession   Session?         @relation(fields: [sourceSessionId], references: [id], onDelete: SetNull)

  @@index([tenantId, planScenarioId])
  @@index([tenantId, scenarioSessionId])
  @@index([tenantId, sourceSessionId])
  @@index([tenantId, changeType])
}

enum RecoveryCaseStatus {
  OPEN
  GENERATING
  READY
  ACCEPTED
  CLOSED
}

enum RecoveryCaseReviewStatus {
  NOT_REQUIRED
  DRAFT
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  RETURNED
}

enum RecoveryDisruptionType {
  INSTRUCTOR_UNAVAILABLE
  ROOM_UNAVAILABLE
}

enum RecoveryProposalStatus {
  CURRENT
  STALE
  ACCEPTED
  REJECTED
}

model RecoveryCase {
  id                   String                   @id @default(uuid())
  tenantId             String
  planId               String
  baseScenarioId       String
  basePlanVersion      Int
  name                 String
  status               RecoveryCaseStatus       @default(OPEN)
  version              Int                      @default(1)
  acceptedScenarioId   String?
  approvalRequired     Boolean
  reviewStatus         RecoveryCaseReviewStatus @default(DRAFT)
  submittedForReviewAt DateTime?
  approvedAt           DateTime?
  publishedPlanId      String?
  publishedAt          DateTime?
  publishedByName      String?
  createdByName        String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan          Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  baseScenario  PlanScenario @relation("RecoveryCaseBaseScenario", fields: [baseScenarioId], references: [id], onDelete: Restrict)
  publishedPlan Plan?        @relation("RecoveryCasePublishedPlan", fields: [publishedPlanId], references: [id], onDelete: SetNull)

  disruptions RecoveryDisruption[]
  proposals   RecoveryCaseProposal[]
  solverJobs  SolverJob[]
  reviewSteps RecoveryCaseReviewStep[]

  @@index([tenantId, planId, status])
  @@index([tenantId, baseScenarioId])
  @@index([tenantId, publishedPlanId])
}

model RecoveryDisruption {
  id             String                 @id @default(uuid())
  tenantId       String
  recoveryCaseId String
  type           RecoveryDisruptionType
  resourceId     String
  resourceLabel  String
  startDate      DateTime               @db.Date
  endDate        DateTime               @db.Date
  startMinute    Int?
  endMinute      Int?
  active         Boolean                @default(true)
  createdByName  String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  recoveryCase RecoveryCase @relation(fields: [recoveryCaseId], references: [id], onDelete: Cascade)

  @@index([tenantId, recoveryCaseId, active])
  @@index([tenantId, type, resourceId])
}

model RecoveryCaseProposal {
  id             String                 @id @default(uuid())
  tenantId       String
  recoveryCaseId String
  scenarioId     String
  caseVersion    Int
  status         RecoveryProposalStatus @default(CURRENT)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  recoveryCase RecoveryCase @relation(fields: [recoveryCaseId], references: [id], onDelete: Cascade)
  scenario     PlanScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@unique([recoveryCaseId, scenarioId])
  @@index([tenantId, recoveryCaseId, status])
  @@index([tenantId, scenarioId])
}

model RecoveryCaseReviewStep {
  id             String               @id @default(uuid())
  tenantId       String
  recoveryCaseId String
  caseVersion    Int
  stage          Int
  position       Int                  @default(1)
  name           String
  reviewerRole   String?
  reviewerId     String?
  reviewerName   String?
  required       Boolean              @default(true)
  status         PlanReviewStepStatus @default(PENDING)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  recoveryCase RecoveryCase @relation(fields: [recoveryCaseId], references: [id], onDelete: Cascade)

  decisions RecoveryCaseReviewDecision[]

  @@unique([tenantId, recoveryCaseId, caseVersion, stage, position])
  @@index([tenantId, recoveryCaseId, caseVersion])
  @@index([tenantId, reviewerId, status])
}

model RecoveryCaseReviewDecision {
  id        String                 @id @default(uuid())
  tenantId  String
  stepId    String
  decision  PlanReviewDecisionType
  actorId   String?
  actorName String?
  comment   String?
  decidedAt DateTime               @default(now())

  tenant Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  step   RecoveryCaseReviewStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([tenantId, stepId, decidedAt])
  @@index([tenantId, actorId, decidedAt])
}

model PlanDistribution {
  id              String             @id @default(uuid())
  tenantId        String
  planId          String
  format          DistributionFormat
  status          DistributionStatus @default(GENERATED)
  fileName        String
  contentType     String
  contentHash     String
  sizeBytes       Int
  generatedByName String?
  generatedAt     DateTime           @default(now())
  metadata        Json?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([tenantId, planId, generatedAt])
  @@index([tenantId, format, generatedAt])
  @@index([tenantId, status, generatedAt])
}

model Plan {
  id                String     @id @default(uuid())
  tenantId          String
  planningScopeId   String
  academicPeriodId  String
  name              String
  version           Int
  status            PlanStatus @default(DRAFT)
  basedOnPlanId     String?
  // Planning dates deliberately separate "today", the frozen window, and the editable horizon.
  // Historical dates before planningStartDate are never rewritten by normal replanning.
  planningAsOfDate  DateTime?  @db.Date
  frozenThroughDate DateTime?  @db.Date
  planningStartDate DateTime?  @db.Date
  planningEndDate   DateTime?  @db.Date

  // Effective dates describe when an approved/published plan revision is intended to apply.
  effectiveFrom DateTime? @db.Date
  effectiveTo   DateTime? @db.Date

  submittedAt   DateTime?
  submittedById String?
  approvedAt    DateTime?
  publishedAt   DateTime?
  publishedById String?
  supersededAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  planningScope  PlanningScope  @relation(fields: [planningScopeId], references: [id], onDelete: Restrict)
  academicPeriod AcademicPeriod @relation(fields: [academicPeriodId], references: [id], onDelete: Restrict)

  basedOnPlan  Plan?  @relation("PlanVersionHistory", fields: [basedOnPlanId], references: [id], onDelete: Restrict)
  derivedPlans Plan[] @relation("PlanVersionHistory")

  scenarios              PlanScenario[]
  sessions               Session[]
  reviewWorkflows        PlanReviewWorkflow[]
  recoveryCases          RecoveryCase[]
  publishedRecoveryCases RecoveryCase[]        @relation("RecoveryCasePublishedPlan")
  distributions          PlanDistribution[]
  teachingRequirements   TeachingRequirement[]

  @@unique([tenantId, planningScopeId, version])
  @@index([tenantId, status])
  @@index([tenantId, planningScopeId])
  @@index([tenantId, academicPeriodId])
}

model PlanReviewWorkflow {
  id          String                   @id @default(uuid())
  tenantId    String
  planId      String
  name        String
  status      PlanReviewWorkflowStatus @default(DRAFT)
  submittedAt DateTime?
  completedAt DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)

  steps PlanReviewStep[]

  @@unique([tenantId, planId, name])
  @@index([tenantId, status])
  @@index([tenantId, planId])
}

model PlanReviewStep {
  id           String               @id @default(uuid())
  tenantId     String
  workflowId   String
  stage        Int
  position     Int                  @default(1)
  name         String
  reviewerRole String?
  reviewerId   String?
  reviewerName String?
  required     Boolean              @default(true)
  status       PlanReviewStepStatus @default(PENDING)
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  workflow PlanReviewWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  decisions PlanReviewDecision[]

  // Multiple reviewers can share a stage (parallel review); position keeps display order stable.
  @@unique([tenantId, workflowId, stage, position])
  @@index([tenantId, workflowId, stage])
  @@index([tenantId, reviewerId, status])
}

model PlanReviewDecision {
  id        String                 @id @default(uuid())
  tenantId  String
  stepId    String
  decision  PlanReviewDecisionType
  actorId   String?
  actorName String?
  comment   String?
  decidedAt DateTime               @default(now())

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  step   PlanReviewStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([tenantId, stepId, decidedAt])
  @@index([tenantId, actorId, decidedAt])
}

model PlanScenario {

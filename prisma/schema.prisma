  sessions ScenarioSession[]

  solverJobs         SolverJob[]
  objectives         SolverObjective[]
  metrics            ScenarioMetric[]
  changes            ScenarioChange[]
  recoveryProposals  RecoveryCaseProposal[]
  basedRecoveryCases RecoveryCase[]         @relation("RecoveryCaseBaseScenario")

  @@index([tenantId, planId])
  @@index([tenantId, status])
}

